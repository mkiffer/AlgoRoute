cabal-version:      3.0
name:               backend-hs
version:            0.1.0.0
synopsis:           AlgoRoute backend — Haskell rewrite (Servant + Warp / AWS Lambda)
build-type:         Simple

-- Settings shared by every stanza below (library, executables, tests).
-- Stanzas opt in with `import: shared`.
common shared
    -- GHC2021 turns on a large, modern set of language extensions by
    -- default, so individual modules need far fewer {-# LANGUAGE #-} pragmas.
    default-language: GHC2021
    -- Enabled project-wide because nearly every module uses `deriving stock`.
    -- Per-module extensions (OverloadedStrings, DuplicateRecordFields, …) stay
    -- as {-# LANGUAGE #-} pragmas in the files that need them.
    default-extensions: DerivingStrategies
    ghc-options:      -Wall
    build-depends:
        base
      , text
      , bytestring
      , containers            -- Data.Map.Strict (Network, heap index)
      , unordered-containers
      , servant-server        -- HTTP API type + server
      , wai                   -- the Application both entry points serve
      , warp                  -- local HTTP server
      , wai-handler-hal       -- WAI → AWS Lambda custom-runtime adapter
      , http-client           -- outbound HTTP (Overpass, Nominatim)
      , http-client-tls
      , aeson                 -- JSON encode/decode
      , async                 -- concurrency
      , stm                   -- TVar-based network cache
      , optparse-applicative  -- CLI flag parsing
      , mtl                   -- ExceptT pipeline
      , case-insensitive      -- HTTP header helpers
      , http-types
      , wai-cors              -- CORS middleware

-- All domain logic lives in the library so both executables — and, later,
-- the test suite — can depend on it without recompiling the sources.
library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:
        Graph
        Mapping
        Geo.Types
        Geo.Distance
        Geo.Geocode
        Geo.Suggest
        Geo.Reverse
        Overpass.Types
        Overpass.Client
        Routefinding.Types
        Routefinding.Heap
        Routefinding.Dijkstra
        Routefinding.AStar
        Services.Cache
        Services.Routing
        API.Types
        API.Handlers

-- AWS Lambda entry point. The -DLAMBDA CPP define selects the HAL runtime
-- branch inside Main.hs. The flake copies this binary to `bootstrap`.
executable backend-hs
    import:           shared
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    backend-hs
    cpp-options:      -DLAMBDA

-- Local Warp server entry point. Same Main.hs, but without -DLAMBDA it
-- compiles the plain `warp run` branch instead.
executable backend-hs-local
    import:           shared
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    backend-hs

-- HSpec test suite. `exitcode-stdio-1.0` = a normal executable that exits
-- non-zero on failure, which `cabal test` interprets as a failing run.
-- Spec.hs uses hspec-discover (a preprocessor) to auto-collect every
-- *Spec module under test/ — add e.g. test/Routefinding/DijkstraSpec.hs
-- and it is picked up with no wiring. `cabal test` runs it all.
test-suite backend-hs-test
    import:             shared
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test
    main-is:            Spec.hs
    build-depends:
        backend-hs        -- the library under test
      , hspec             -- test framework
      , hspec-wai         -- HTTP handler tests (Servant endpoints)
      , QuickCheck        -- property-based tests
      , aeson             -- decode the shared JSON fixture in tests
      , bytestring        -- read the fixture file
      , containers        -- Map assertions on the built Network
      , wai               -- build the Application under test
      , servant-server    -- serve the API in HandlersSpec
    -- hspec-discover generates the driver, but Cabal still needs every *Spec
    -- module listed here. Add one line per new spec file you create.
    other-modules:
        Geo.TypesSpec
        Geo.DistanceSpec
        Routefinding.HeapSpec
        Routefinding.DijkstraSpec
        Overpass.TypesSpec
        MappingSpec
        API.HandlersSpec
    -- Runs the hspec-discover preprocessor to generate the test driver.
    build-tool-depends: hspec-discover:hspec-discover
