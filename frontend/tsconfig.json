{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "lib": ["ES2022", "esnext.disposable", "DOM", "DOM.Iterable"],
    "isolatedModules": true,
    "skipLibCheck": false
  },
  "include": ["src/**/*.ts"]
}
